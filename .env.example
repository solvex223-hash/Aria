# Copy these names into Render > your service > Environment. Never commit real values.

# --- Required ---
GROQ_API_KEY=
ADMIN_NUMBER=                 # your number, digits only with country code, e.g. 2348012345678
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # service_role key (keeps the WhatsApp login across Render restarts)

# --- Already in your .env, keep them ---
GROQ_TEXT_MODEL=
GROQ_MODEL=
GROQ_VISION_MODELS=
ADMIN_NOTIFY_NUMBER=

# --- Optional: only if you use the daily-report /send route ---
ARIA_SEND_KEY=

# --- Optional behaviour (defaults shown) ---
REPLY_TO_ALL=true             # answer everyone who messages; /off <number> still blocks people
GROUP_DEFAULT=mention         # mention | all | off, for groups you never configured
SHOW_TYPING=true              # "typing..." while Aria works
MARK_READ=true                # blue ticks when Aria starts answering
REPLY_DELAY_MS=1000           # "reading" pause before typing starts
TYPING_MS_PER_CHAR=28         # typing speed
MAX_REPLIES_PER_MIN=8         # safety brake per chat

# --- Optional: stickers, videos and group vibe (defaults shown) ---
GROUP_TRIGGER_WORDS=aria
GROUP_VIBE_MESSAGES=20
VIDEO_MAX_MB=16
VIDEO_MAX_SECONDS=30
